# Copiar a .env y completar (chmod 600 .env). Lo leen la app (local) y docker compose.

# PIN por perfil (phones.json → pin_env). Fallback: NX_PIN.
NX_PIN=000000
# NX_PIN_MOTO=000000

# Perfil activo (opcional; también en ~/.config/no-phone/phones.json → activo)
# NX_PHONE=redmi7

# Fallback si no hay phones.json / serial vacío
ANDROID_SERIAL=TU_SERIAL

# WALLET_BOT_TOKEN=opcional (en VPS: obligatorio)
# NX_PHONES_FILE=/ruta/alternativa/phones.json
# PIN cargado desde la consola web (admin/): <dir>/<perfil>.env, gana sobre este .env
# NX_PHONE_SECRETS_DIR=~/.config/no-phone/devices
# NX_UI_MODE=fast   (si no está, usa ui_mode del perfil en phones.json)

# --- Docker (ver DOCKER.md) ---
# remote: adb server de otro host (celu por USB ahí) · connect: adb connect ip:5555 · usb: USB directo (local)
ADB_MODE=remote
ANDROID_ADB_SERVER_HOST=host.docker.internal
ANDROID_ADB_SERVER_PORT=5037
# ADB_CONNECT=192.168.1.50:5555
# MCP HTTP: token Bearer obligatorio (lo usan los 3 conectores en Docker)
# MCP_HTTP_TOKEN=
# MENDOTRAN_TOKEN=   # token de la web pública de Mendotran (owa.visionblo.com), para micros en tiempo real
